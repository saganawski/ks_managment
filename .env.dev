SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/management?useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=spring
SPRING_DATASOURCE_PASSWORD=springpw
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# SPRING_DATASOURCE_HIKARI_INITIALIZATION_FAIL_TIMEOUT=-1   # never fail fast
# SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=60000         # wait up to 60 s
FLYWAY_CONNECT_RETRIES=10